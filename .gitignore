# Public-safe repository rule:
# Do not publish real personal photos, private screenshots, audio, video, or resume files.
# SVG icons are intentionally not blocked, because they are non-private UI/tech-stack assets.
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.png
assets/**/*.JPG
assets/**/*.JPEG
assets/**/*.PNG
assets/**/*.gif
assets/**/*.webp
assets/**/*.mov
assets/**/*.mp4
assets/**/*.mp3
assets/**/*.wav
assets/**/*.pdf

